#!/bin/sh
set -eu

python_command=${REDEV_PYTHON:-}
if [ -z "$python_command" ]; then
  for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
      python_command=$candidate
      break
    fi
  done
fi

if [ -n "$python_command" ] && "$python_command" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
  exec "$python_command" -c 'import sys; from pathlib import Path; sys.path.insert(0, str(Path(sys.argv[1]).resolve().parent)); from redev.__main__ import main; sys.exit(main(sys.argv[2:]))' "$0" "$@"
fi

printf '%s\n' 'gh-redev needs Python 3.11 or newer. Install it or set REDEV_PYTHON to its executable.' >&2
exit 70
